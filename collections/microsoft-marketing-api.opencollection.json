{
  "opencollection": "1.0.0",
  "info": {
    "name": "LinkedIn Marketing API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://www.linkedin.com/oauth/v2/authorization",
      "accessTokenUrl": "https://www.linkedin.com/oauth/v2/accessToken",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Marketing",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List ad accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.linkedin.com/v2/adAccounts",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query"
              },
              {
                "name": "search.status.values[0]:",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List the LinkedIn Ad Accounts associated with the authenticated user."
        }
      ]
    }
  ],
  "bundled": true
}