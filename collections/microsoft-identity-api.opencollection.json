{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Azure Cognitive Services Accounts Identity API",
    "version": "3.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Ocp-Apim-Subscription-Key",
      "value": "{{Ocp-Apim-Subscription-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Identity",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Create an identity",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{region}.api.cognitive.microsoft.com/identities",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "API version"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new Communication Services identity."
        },
        {
          "info": {
            "name": "Microsoft Delete an identity",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{region}.api.cognitive.microsoft.com/identities/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifier of the identity to delete"
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "API version"
              }
            ]
          },
          "docs": "Delete a Communication Services identity and revoke all tokens."
        },
        {
          "info": {
            "name": "Microsoft Issue an access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{region}.api.cognitive.microsoft.com/identities/:id/:issueAccessToken",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "API version"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Issue a new access token for an identity."
        }
      ]
    }
  ],
  "bundled": true
}