{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Azure Cognitive Services Accounts Imports API",
    "version": "3.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Ocp-Apim-Subscription-Key",
      "value": "{{Ocp-Apim-Subscription-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Imports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Import a PBIX file",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{region}.api.cognitive.microsoft.com/imports",
            "params": [
              {
                "name": "datasetDisplayName",
                "value": "",
                "type": "query",
                "description": "Display name for the dataset"
              },
              {
                "name": "nameConflict",
                "value": "",
                "type": "query",
                "description": "Action on name conflict"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Imports a Power BI .pbix file into My workspace."
        }
      ]
    }
  ],
  "bundled": true
}