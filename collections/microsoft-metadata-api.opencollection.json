{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Azure Cognitive Services Accounts Metadata API",
    "version": "3.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Ocp-Apim-Subscription-Key",
      "value": "{{Ocp-Apim-Subscription-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Metadata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft List entity definitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{region}.api.cognitive.microsoft.com/EntityDefinitions",
            "params": [
              {
                "name": "$select",
                "value": "",
                "type": "query",
                "description": "Properties to include"
              },
              {
                "name": "$filter",
                "value": "",
                "type": "query",
                "description": "OData filter expression"
              }
            ]
          },
          "docs": "Retrieve metadata about all entities in the environment."
        }
      ]
    }
  ],
  "bundled": true
}