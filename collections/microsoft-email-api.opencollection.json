{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Azure Cognitive Services Accounts Email API",
    "version": "3.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Ocp-Apim-Subscription-Key",
      "value": "{{Ocp-Apim-Subscription-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Email",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Send an email",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{region}.api.cognitive.microsoft.com/emails:send",
            "params": [
              {
                "name": "api-version",
                "value": "",
                "type": "query",
                "description": "API version"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Queues an email message for sending."
        }
      ]
    }
  ],
  "bundled": true
