{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Azure Cognitive Services Accounts Drives API",
    "version": "3.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Ocp-Apim-Subscription-Key",
      "value": "{{Ocp-Apim-Subscription-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Drives",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Get current user's drive",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{region}.api.cognitive.microsoft.com/me/drive"
          },
          "docs": "Retrieve the properties and relationships of a user's OneDrive."
        }
      ]
    }
  ],
  "bundled": true
}